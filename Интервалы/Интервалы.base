filters:
  and:
    - type == "interval"
properties:
  short:
    displayName: Обозначение
  semitones:
    displayName: Полутонов
  mastered:
    displayName: Освоено
views:
  - type: table
    name: Все интервалы
    order:
      - file.name
      - short
      - semitones
      - mastered
    summaries:
      mastered: Checked
  - type: table
    name: Не освоены
    filters:
      and:
        - mastered == false
    order:
      - file.name
      - short
      - semitones
