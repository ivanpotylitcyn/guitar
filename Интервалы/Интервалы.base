filters:
  and:
    - type == "interval"
properties:
  short:
    displayName: Обозначение
  semitones:
    displayName: Полутонов
  mastered:
    displayName: Освоено
  last_practiced:
    displayName: Последняя тренировка
  practice_min:
    displayName: Минут всего
views:
  - type: table
    name: Все интервалы
    order:
      - file.name
      - short
      - semitones
      - mastered
      - last_practiced
      - practice_min
    summaries:
      mastered: Checked
      practice_min: Sum
  - type: table
    name: Давно не тренировал
    order:
      - file.name
      - short
      - last_practiced
      - practice_min
      - mastered
    sort:
      - property: last_practiced
        direction: ASC
  - type: table
    name: Не освоены
    filters:
      and:
        - mastered == false
    order:
      - file.name
      - short
      - semitones
