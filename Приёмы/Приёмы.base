filters:
  and:
    - type == "technique"
properties:
  name:
    displayName: Название
  area:
    displayName: Область
  mastered:
    displayName: Освоено
  last_practiced:
    displayName: Последняя тренировка
  practice_min:
    displayName: Минут всего
views:
  - type: table
    name: Все приёмы
    groupBy:
      property: area
      direction: ASC
    order:
      - file.name
      - area
      - mastered
      - last_practiced
      - practice_min
    summaries:
      mastered: Checked
      practice_min: Sum
  - type: table
    name: Давно не тренировал
    order:
      - file.name
      - area
      - last_practiced
      - practice_min
      - mastered
    sort:
      - property: last_practiced
        direction: ASC
