filters:
  and:
    - type == "chord"
properties:
  name:
    displayName: Название
  root:
    displayName: Тоника
  quality:
    displayName: Тип
  mastered:
    displayName: Освоено
  last_practiced:
    displayName: Последняя тренировка
  practice_min:
    displayName: Минут всего
views:
  - type: table
    name: Все аккорды
    groupBy:
      property: quality
      direction: ASC
    order:
      - file.name
      - name
      - root
      - quality
      - mastered
      - last_practiced
      - practice_min
    summaries:
      mastered: Checked
      practice_min: Sum
  - type: table
    name: Давно не тренировал
    order:
      - file.name
      - name
      - last_practiced
      - practice_min
      - mastered
    sort:
      - property: last_practiced
        direction: ASC
  - type: table
    name: Не освоены
    filters:
      and:
        - mastered == false
    order:
      - file.name
      - name
      - root
      - quality
