filters:
  and:
    - file.hasProperty("mastered")
properties:
  type:
    displayName: Тема
  name:
    displayName: Название
  mastered:
    displayName: Освоено
  last_practiced:
    displayName: Последняя тренировка
  practice_min:
    displayName: Минут всего
views:
  - type: table
    name: Всё по темам
    groupBy:
      property: type
      direction: ASC
    order:
      - type
      - name
      - mastered
    summaries:
      mastered: Checked
    columnSize:
      note.name: 117
  - type: table
    name: Ещё не освоено
    filters:
      and:
        - mastered == false
    groupBy:
      property: type
      direction: ASC
    order:
      - type
      - name
  - type: table
    name: Тренировки
    order:
      - type
      - file.name
      - last_practiced
      - practice_min
      - mastered
    sort:
      - property: last_practiced
        direction: ASC
    summaries:
      practice_min: Sum
  - type: table
    name: Ни разу не тренировал
    filters:
      and:
        - '!file.hasProperty("last_practiced")'
    groupBy:
      property: type
      direction: ASC
    order:
      - type
      - file.name
      - mastered
