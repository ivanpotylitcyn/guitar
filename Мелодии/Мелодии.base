filters:
  and:
    - type == "melody"
properties:
  name:
    displayName: Название
  key:
    displayName: Тональность
  tempo_bpm:
    displayName: BPM
  frets:
    displayName: Лады
  mastered:
    displayName: Освоено
  last_practiced:
    displayName: Последняя тренировка
  practice_min:
    displayName: Минут всего
views:
  - type: table
    name: Все мелодии
    order:
      - file.name
      - key
      - frets
      - tempo_bpm
      - mastered
      - last_practiced
      - practice_min
    summaries:
      mastered: Checked
      practice_min: Sum
  - type: table
    name: Не освоены
    filters:
      and:
        - mastered == false
    order:
      - file.name
      - key
      - frets
      - tempo_bpm
  - type: table
    name: Давно не тренировал
    order:
      - file.name
      - key
      - last_practiced
      - practice_min
      - mastered
    sort:
      - property: last_practiced
        direction: ASC
